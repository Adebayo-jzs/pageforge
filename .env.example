# Gemini API Key (Required)
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional fallback)
OPENAI_API_KEY=your_openai_api_key_here

# Groq API Key (Optional fallback)
# Get one at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# MongoDB Connection String
MONGODB_URI=mongodb+srv://...

# NextAuth Configuration
AUTH_SECRET=your_auth_secret_here # Run `npx auth secret` to generate
NEXTAUTH_URL=http://localhost:3000

# Public deployment host used for generated site URLs and domain detection
NEXT_PUBLIC_APP_DOMAIN=your-app.vercel.app
NEXT_PUBLIC_VERCEL_CNAME_TARGET=cname.vercel-dns.com
NEXT_PUBLIC_VERCEL_A_RECORD=76.76.21.21

# Server-side DNS verification targets
VERCEL_CNAME_TARGET=cname.vercel-dns.com
VERCEL_A_RECORD=76.76.21.21

# Vercel Domains API (Required for programmatically connecting custom domains)
VERCEL_PROJECT_ID=your_vercel_project_id_here
VERCEL_API_TOKEN=your_vercel_api_token_here
VERCEL_TEAM_ID=your_vercel_team_id_here # Optional, only needed if project is under a team

# OAuth Providers (Optional)
GITHUB_CLIENT_ID=...
GITHUB_CLIENT_SECRET=...
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
